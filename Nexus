local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer
local adminEvent = ReplicatedStorage:WaitForChild("NexusAdminEvent")

-- 1. Création du ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "NexusAdminGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = localPlayer:WaitForChild("PlayerGui")

-- 2. Bouton d'ouverture Mobile (Bouton rond fixe sur l'écran)
local toggleBtn = Instance.new("TextButton")
toggleBtn.Name = "MobileToggleBtn"
toggleBtn.Size = UDim2.new(0, 50, 0, 50)
toggleBtn.Position = UDim2.new(0, 15, 0.4, 0) -- Situé à gauche de l'écran
toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 220)
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.Text = "NEXUS"
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.TextSize = 11
toggleBtn.Parent = screenGui

-- Arrondir le bouton mobile
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = toggleBtn

-- 3. Fenêtre principale du Menu Nexus
local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.new(0, 300, 0, 360)
mainFrame.Position = UDim2.new(0.5, -150, 0.5, -180)
mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
mainFrame.BorderColor3 = Color3.fromRGB(0, 220, 255)
mainFrame.BorderSizePixel = 2
mainFrame.Visible = false -- Masqué par défaut
mainFrame.Parent = screenGui

-- Titre du Menu
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundTransparency = 1
title.Text = "NEXUS ADMIN"
title.TextColor3 = Color3.fromRGB(0, 220, 255)
title.TextSize = 18
title.Font = Enum.Font.GothamBold
title.Parent = mainFrame

-- Champ pour le nom de la cible
local targetInput = Instance.new("TextBox")
targetInput.Size = UDim2.new(0.9, 0, 0, 35)
targetInput.Position = UDim2.new(0.05, 0, 0, 45)
targetInput.PlaceholderText = "Nom du joueur cible..."
targetInput.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
targetInput.TextColor3 = Color3.fromRGB(255, 255, 255)
targetInput.Font = Enum.Font.Gotham
targetInput.TextSize = 14
targetInput.Parent = mainFrame

-- Conteneur pour les boutons d'action
local buttonContainer = Instance.new("Frame")
buttonContainer.Size = UDim2.new(0.9, 0, 0.7, 0)
buttonContainer.Position = UDim2.new(0.05, 0, 0.25, 0)
buttonContainer.BackgroundTransparency = 1
buttonContainer.Parent = mainFrame

local layout = Instance.new("UIGridLayout")
layout.CellSize = UDim2.new(0.48, 0, 0, 40)
layout.CellPadding = UDim2.new(0.04, 0, 0.03, 0)
layout.Parent = buttonContainer

-- Fonction de création de bouton
local function createButton(text, callback)
	local btn = Instance.new("TextButton")
	btn.Text = text
	btn.BackgroundColor3 = Color3.fromRGB(0, 40, 60)
	btn.TextColor3 = Color3.fromRGB(0, 220, 255)
	btn.BorderSizePixel = 1
	btn.BorderColor3 = Color3.fromRGB(0, 180, 220)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.Parent = buttonContainer
	
	btn.MouseButton1Click:Connect(callback)
	return btn
end

-- Variables d'état
local isFlying = false
local isInvis = false
local isGod = false

-- Instanciation des fonctionnalités
createButton("Vol : OFF", function()
	isFlying = not isFlying
	adminEvent:FireServer("ToggleFly", isFlying)
end)

createButton("Vitesse x5", function()
	adminEvent:FireServer("SetSpeed", 80)
end)

createButton("Invisibilité", function()
	isInvis = not isInvis
	adminEvent:FireServer("SetInvisibility", isInvis)
end)

createButton("God Mode", function()
	isGod = not isGod
	adminEvent:FireServer("SetGodMode", isGod)
end)

createButton("Téléportation", function()
	if targetInput.Text ~= "" then
		adminEvent:FireServer("TeleportTo", targetInput.Text)
	end
end)

createButton("Gravité", function()
	adminEvent:FireServer("ToggleGravity")
end)

createButton("Soigner", function()
	adminEvent:FireServer("HealSelf")
end)

createButton("Tuer Cible", function()
	if targetInput.Text ~= "" then
		adminEvent:FireServer("KillPlayer", targetInput.Text)
	end
end)

-- Ouverture / Fermeture avec le bouton Mobile
toggleBtn.MouseButton1Click:Connect(function()
	mainFrame.Visible = not mainFrame.Visible
end)

-- Ouverture / Fermeture avec la touche K (PC)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.K then
		mainFrame.Visible = not mainFrame.Visible
	end
end)
