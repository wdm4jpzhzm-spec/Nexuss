-- Fonction utilitaire pour créer des boutons propres
local function CreateBtn(text, color, action)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 50)
    btn.Position = UDim2.new(0, 10, 0, 50)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothenBold
    btn.TextSize = 16
    btn.Parent = Frame
    
    -- Clic classique et tactile
    btn.MouseButton1Click:Connect(action)
    btn.TouchTap:Connect(action)
    
    return btn
end

