-- C. TP (Téléportation)
CreateButton("TP Aléatoire", Color3.fromRGB(150, 50, 50), function()
    -- TP vers une position aléatoire autour du joueur
    local origin = Character.PrimaryPart.Position
    local randomPos = origin + Vector3.new(math.random(-50, 50), 0, math.random(-50, 50))
    Character:SetPrimaryPartCFrame(CFrame.new(randomPos.X, randomPos.Y + 20, randomPos.Z))
    print("TP réussi")
end, Color3.fromRGB(150, 50, 50))

-- D. NOCLIP (Passer à travers les murs)
CreateButton("Noclip (Mode Vol)", Color3.fromRGB(100, 100, 200), function()
    -- Vérifier si le mode est déjà actif
    local isNoclipActive = false
    for _, v in pairs(Character:GetChildren()) do
        if v:IsA("BasePart") and v.CanCollide == false then
            isNoclipActive = true
            break
        end
    end
    
    if isNoclipActive then
        -- Désactiver
        for _, v in pairs(Character:GetChildren()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
                v.Transparency = 0
            end
        end
    else
        -- Activer
        for _, v in pairs(Character:GetChildren()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
                v.Transparency = 0.7 -- Devient transparent
            end
        end
    end
end, Color3.fromRGB(100, 100, 200))

